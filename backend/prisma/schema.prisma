// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, fuzzystrmatch, postgis_topology, postgis_raster]
}

model User {
  id        Int          @id @default(autoincrement())
  googleId  String       @unique
  avatar    String?
  firstName String
  lastName  String?
  email     String?      @unique
  roleName  UserRoleEnum @default(SALES)
  phone     String?
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  locations Location[]

  // Relations
  branchesAsSales      Branch[]     @relation("BranchToSales")
  branchesAsSupervisor Branch[]     @relation("BranchToSupervisor")
  branchesAsCreator    Branch[]     @relation("BranchToCreator")
  competitorsAsCreator Competitor[] @relation("CompetitorToCreator")
  poisAsCreator        Poi[]        @relation("PoiToCreator")
}

enum UserRoleEnum {
  CEO
  SALES
  SALES_SUPERVISOR
  ADMIN
}

model Location {
  id          Int              @id @default(autoincrement())
  address     String?
  zipCode     String?
  subDistrict String?
  district    String?
  province    String?
  type        LocationTypeEnum
  latitude    Float
  longitude   Float
  isDeleted   Boolean          @default(false)
  createdById Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  branch     Branch?
  competitor Competitor?
  poi        Poi?
  createdBy  User?       @relation(fields: [createdById], references: [id])
  isochrones Isochrone[]
}

enum LocationTypeEnum {
  BRANCH
  COMPETITOR
  POI
}

model Branch {
  id                Int      @id @default(autoincrement())
  name              String
  email             String?  @unique @db.VarChar(255)
  salesId           Int?
  salesSupervisorId Int?
  locationId        Int      @unique
  isDeleted         Boolean  @default(false)
  createdById       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  location           Location             @relation(fields: [locationId], references: [id])
  createdBy          User?                @relation("BranchToCreator", fields: [createdById], references: [id])
  supervisor         User?                @relation("BranchToSupervisor", fields: [salesSupervisorId], references: [id])
  sales              User?                @relation("BranchToSales", fields: [salesId], references: [id])
  MonthlyParcelCount MonthlyParcelCount[]
}

model MonthlyParcelCount {
  id         Int      @id @default(autoincrement())
  totalCount Int      @db.Integer
  email      String   @db.VarChar(255)
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  branch Branch? @relation(fields: [email], references: [email])
}

model Competitor {
  id          Int      @id @default(autoincrement())
  name        String
  locationId  Int?     @unique
  isDeleted   Boolean  @default(false)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  location  Location? @relation(fields: [locationId], references: [id])
  createdBy User?     @relation("CompetitorToCreator", fields: [createdById], references: [id])
}

model Poi {
  id          Int      @id @default(autoincrement())
  name        String
  locationId  Int?     @unique
  isDeleted   Boolean  @default(false)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  location  Location? @relation(fields: [locationId], references: [id])
  createdBy User?     @relation("PoiToCreator", fields: [createdById], references: [id])
}

model Isochrone {
  id          Int      @id @default(autoincrement())
  locationId  Int
  geoJson     Json
  profile     String   @db.VarChar(50) // e.g., "driving", "walking"
  range       Int      @db.Integer // meters or seconds depending on your definition
  duration    Int?     @db.Integer // optional: duration in seconds
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  location Location @relation(fields: [locationId], references: [id])
}
